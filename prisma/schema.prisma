generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchConcept {
  fried
  burger
  ash
  cafe
}

enum CatalogItemType {
  RAW
  WEIGHED_SALE
  PIECE
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  WASTE
  ADJUSTMENT
}

enum SaleSource {
  MANUAL
  SCALE_RECEIPT
  SCALE_SERIAL
}

enum ScaleConnection {
  USB
  RS232
  PS2
  BARCODE_ONLY
}

enum ScaleEventStatus {
  pending
  parsed
  failed
}

enum ScaleBusinessEventType {
  sale
  manual
  prep_in
  prep_out
  waste
}

enum StaffRole {
  owner
  branchManager
  cashier
  chef
}

model CustomerMenuItem {
  id        String        @id @default(cuid())
  concept   BranchConcept
  name      String
  priceRial Int
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([concept, isActive, sortOrder])
}

model Branch {
  id        String        @id @default(cuid())
  legacyId  String?       @unique
  name      String
  city      String
  concept   BranchConcept
  isOpen    Boolean       @default(true)
  isPilot              Boolean       @default(false)
  pilotDefaultSalePlu  String?
  createdAt            DateTime      @default(now())

  catalogItems           CatalogItem[]
  branchStocks           BranchStock[]
  stockMovements         StockMovement[]
  purchaseInvoices       PurchaseInvoice[]
  saleInvoices           SaleInvoice[]
  scaleTickets           ScaleTicket[]
  scaleDevices           ScaleDevice[]
  scaleIntegrationEvents ScaleIntegrationEvent[]
  scaleAgentHeartbeats   ScaleAgentHeartbeat[]
  scaleAgentLogUploads   ScaleAgentLogUpload[]
  purchaseYieldRules     PurchaseYieldRule[]
  purchaseBatches        PurchaseBatch[]
}

model CatalogItem {
  id                 String          @id @default(cuid())
  branchId           String?
  pluCode            String?
  barcode            String?
  name               String
  type               CatalogItemType
  unitPriceRialPerKg BigInt?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())

  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchStocks   BranchStock[]
  stockMovements StockMovement[]
  purchaseLines       PurchaseLine[]
  saleLines           SaleLine[]
  purchaseYieldRulesRaw  PurchaseYieldRule[] @relation("YieldRuleRaw")
  purchaseYieldRulesSale PurchaseYieldRule[] @relation("YieldRuleSale")
  purchaseBatchesRaw     PurchaseBatch[]     @relation("BatchRaw")
  purchaseBatchesSale    PurchaseBatch[]     @relation("BatchSale")

  @@index([branchId, pluCode])
}

model BranchStock {
  id             String @id @default(cuid())
  branchId       String
  catalogItemId  String
  quantityGrams  Int    @default(0)

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, catalogItemId])
}

model StockMovement {
  id            String            @id @default(cuid())
  branchId      String
  catalogItemId String
  type          StockMovementType
  quantityGrams Int
  referenceKind String
  referenceId   String
  note          String?
  createdAt     DateTime          @default(now())

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt])
}

model PurchaseInvoice {
  id           String   @id @default(cuid())
  branchId     String
  invoiceNo    String?
  purchasedAt  DateTime @default(now())
  supplierName String?
  totalRial    BigInt
  createdBy    String?
  createdAt    DateTime @default(now())

  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines  PurchaseLine[]
}

model PurchaseLine {
  id                  String @id @default(cuid())
  purchaseInvoiceId   String
  catalogItemId       String
  weightGrams         Int
  unitPriceRialPerKg  BigInt
  lineTotalRial       BigInt

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  catalogItem     CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  purchaseBatch   PurchaseBatch?
}

model PurchaseYieldRule {
  id                String @id @default(cuid())
  branchId          String
  rawCatalogItemId  String
  saleCatalogItemId String
  yieldBps          Int

  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rawCatalogItem  CatalogItem @relation("YieldRuleRaw", fields: [rawCatalogItemId], references: [id], onDelete: Restrict)
  saleCatalogItem CatalogItem @relation("YieldRuleSale", fields: [saleCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([branchId, rawCatalogItemId])
}

model PurchaseBatch {
  id                     String   @id @default(cuid())
  branchId               String
  purchaseLineId         String   @unique
  rawCatalogItemId       String
  saleCatalogItemId      String
  purchasedAt            DateTime
  rawGrams               Int
  expectedSellableGrams  Int
  allocatedSoldGrams     Int      @default(0)
  createdAt              DateTime @default(now())

  branch               Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseLine         PurchaseLine              @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  rawCatalogItem       CatalogItem               @relation("BatchRaw", fields: [rawCatalogItemId], references: [id], onDelete: Restrict)
  saleCatalogItem      CatalogItem               @relation("BatchSale", fields: [saleCatalogItemId], references: [id], onDelete: Restrict)
  saleLineAllocations  SaleLineBatchAllocation[]

  @@index([branchId, purchasedAt])
}

model SaleLineBatchAllocation {
  id              String @id @default(cuid())
  saleLineId      String
  purchaseBatchId String
  gramsAllocated  Int

  saleLine      SaleLine      @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  purchaseBatch PurchaseBatch @relation(fields: [purchaseBatchId], references: [id], onDelete: Cascade)

  @@index([purchaseBatchId])
  @@index([saleLineId])
}

model SaleInvoice {
  id              String     @id @default(cuid())
  branchId        String
  soldAt          DateTime   @default(now())
  source          SaleSource @default(SCALE_RECEIPT)
  scaleInvoiceNo  String?
  scaleLabel      String?
  boothLabel      String?
  totalRial       BigInt
  reprint         Boolean    @default(false)
  createdAt       DateTime   @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines        SaleLine[]
  scaleTickets ScaleTicket[]
}

model SaleLine {
  id                 String @id @default(cuid())
  saleInvoiceId      String
  catalogItemId      String
  weightGrams        Int
  unitPriceRialPerKg BigInt
  lineTotalRial      BigInt

  saleInvoice              SaleInvoice               @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
  catalogItem              CatalogItem               @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  purchaseBatchAllocations SaleLineBatchAllocation[]
}

model ScaleTicket {
  id                  String   @id @default(cuid())
  branchId            String
  saleInvoiceId       String?
  rawBarcode          String?
  parsedWeightGrams   Int?
  parsedUnitPriceRial BigInt?
  payload             Json?
  createdAt           DateTime @default(now())

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleInvoice SaleInvoice? @relation(fields: [saleInvoiceId], references: [id], onDelete: SetNull)
}

model ScaleDevice {
  id         String          @id @default(cuid())
  branchId   String
  model      String          @default("RADIN")
  connection ScaleConnection @default(BARCODE_ONLY)
  label      String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  branch Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  events ScaleIntegrationEvent[]
}

model ScaleIntegrationEvent {
  id             String                 @id @default(cuid())
  branchId       String
  deviceId       String?
  agentHostname  String?
  eventType      ScaleBusinessEventType @default(sale)
  clientEventId  String?
  rawPayload     Json
  status         ScaleEventStatus       @default(pending)
  saleInvoiceId  String?
  createdAt      DateTime               @default(now())

  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device ScaleDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([branchId, clientEventId])
  @@index([branchId, createdAt])
  @@index([branchId, eventType])
}

model ScaleAgentHeartbeat {
  id         String   @id @default(cuid())
  branchId   String
  hostname   String
  lastSeenAt DateTime @default(now())
  payload    Json

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, hostname])
  @@index([branchId, lastSeenAt])
}

model ScaleAgentLogUpload {
  id         String   @id @default(cuid())
  branchId   String
  receivedAt DateTime @default(now())
  lines      Json

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, receivedAt])
}

model StaffUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         StaffRole @default(branchManager)
  createdAt    DateTime  @default(now())
}
